{
  "name": "pitchprox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "create-user": "node scripts/create-user.mjs",
    "test:ai": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/ai/*.test.mjs",
    "test:api": "node --test --test-concurrency=1 \"tests/api/*.test.mjs\"",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:demo": "node scripts/seed.mjs && node scripts/seed-demo.mjs",
    "test:db": "MYSQL_DATABASE=pitchprox_test node scripts/migrate.mjs && MYSQL_DATABASE=pitchprox_test node scripts/seed.mjs",
    "test:server": "MYSQL_DATABASE=pitchprox_test CALL_SERVICE_SECRET=test-call-secret TWILIO_ACCOUNT_SID=ACtest TWILIO_API_KEY=SKtest TWILIO_API_SECRET=test POSTMARK_SERVER_TOKEN=test-token POSTMARK_API_URL=http://127.0.0.1:3002 POSTMARK_WEBHOOK_SECRET=test-webhook-secret next start -p 3001",
    "jobs": "node scripts/campaign-jobs.mjs",
    "calls": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON services/call-service.mjs"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.25.0",
    "mysql2": "^3.24.6",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "recharts": "^3.9.2",
    "sweetalert2": "^11.26.25",
    "swiper": "^14.1.0",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4"
  }
}
